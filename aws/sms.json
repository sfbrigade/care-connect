{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Template to set up SMS sending privileges",
  "Parameters": {
    "BaseName": {
      "Description": "Base name for the stack",
      "Type": "String"
    }
  },
  "Outputs": {
    "SMSUserAccessKeyId": {
      "Description": "Access Key ID for the user",
      "Value": {
        "Ref": "SMSUserAccessKey"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-sms-user-access-key-id"
        }
      }
    },
    "SMSUserSecretAccessKeyARN": {
      "Description": "ARN for the Secrets Manager secret containing the Secret Access Key for the user",
      "Value": {
        "Ref": "SMSUserSecretAccessKey"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${BaseName}-sms-user-secret-access-key-arn"
        }
      }
    }
  },
  "Resources": {
    "SMSUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "Policies": [
          {
            "PolicyName": {
              "Fn::Sub": "${BaseName}-sms-policy"
            },
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "sms-voice:*",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SMSInboundSQSQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "UserName": {
          "Fn::Sub": "${BaseName}-sms-user"
        }
      }
    },
    "SMSUserAccessKey": {
      "Type": "AWS::IAM::AccessKey",
      "Properties": {
        "Status": "Active",
        "UserName": {
          "Ref": "SMSUser"
        }
      }
    },
    "SMSUserSecretAccessKey": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "/iam/user/${BaseName}-sms-user/secret-access-key"
        },
        "SecretString": {
          "Fn::GetAtt": [
            "SMSUserAccessKey",
            "SecretAccessKey"
          ]
        }
      }
    },
    "SMSInboundSQSQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${BaseName}-sms-inbound"
        }
      }
    },
    "SMSInboundSNSTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": {
          "Fn::Sub": "${BaseName}-sms-inbound"
        }
      }
    },
    "SMSInboundSQSPolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Id": {
            "Fn::Sub": "${BaseName}-sms-inbound-sqs-policy"
          },
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "sns.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "SMSInboundSQSQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Ref": "SMSInboundSNSTopic"
                  }
                }
              }
            }
          ]
        },
        "Queues": [
          {
            "Ref": "SMSInboundSQSQueue"
          }
        ]
      }
    },
    "SMSInboundSNSTopicSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "Endpoint": {
          "Fn::GetAtt": [
            "SMSInboundSQSQueue",
            "Arn"
          ]
        },
        "Protocol": "sqs",
        "RawMessageDelivery": true,
        "TopicArn": {
          "Ref": "SMSInboundSNSTopic"
        }
      }
    }
  }
}