{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Deploy a network load balancer with static IPs in front of an application load balancer handling SSL termination and redirects.",
  "Parameters": {
    "BaseName": {
      "Description": "Base name for the stack",
      "Type": "String"
    }
  },
  "Outputs": {},
  "Resources": {
    "SSLCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {
          "Fn::Join": [
            ".",
            [
              "*",
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${BaseName}-domain"
                }
              }
            ]
          ]
        },
        "SubjectAlternativeNames": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${BaseName}-domain"
            }
          }
        ],
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-domain"
              }
            },
            "HostedZoneId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-public-hosted-zone-id"
              }
            }
          }
        ]
      },
    },
    "ApplicationLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": {
          "Fn::Sub": "${BaseName}-alb"
        },
        "Scheme": "internal",
        "Type": "application",
        "SubnetMappings": [
          {
            "SubnetId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-private-subnet-az0-id"
              }
            }
          },
          {
            "SubnetId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-private-subnet-az1-id"
              }
            }
          }
        ]
      }
    },
    "ApplicationLoadBalancerTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${BaseName}-alb-target-group"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-vpc-id"
          }
        }
      }
    },
    "ApplicationLoadBalancerListener80": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ApplicationLoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": 443,
              "Host": "#{host}",
              "Path": "/#{path}",
              "Query": "#{query}",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "ApplicationLoadBalancerListener443": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ApplicationLoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "SSLCertificate"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "ApplicationLoadBalancerTargetGroup"
            }
          }
        ]
      }
    },
    "NetworkLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": {
          "Fn::Sub": "${BaseName}-nlb"
        },
        "Scheme": "internet-facing",
        "Type": "network",
        "SubnetMappings": [
          {
            "SubnetId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-public-subnet-az0-id"
              }
            },
            "AllocationId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-elastic-ip-0-allocation-id"
              }
            }
          },
          {
            "SubnetId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-public-subnet-az1-id"
              }
            },
            "AllocationId": {
              "Fn::ImportValue": {
                "Fn::Sub": "${BaseName}-elastic-ip-1-allocation-id"
              }
            }
          }
        ]
      }
    },
    "NetworkLoadBalancerTargetGroup80": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${BaseName}-nlb-target-group-80"
        },
        "Port": 80,
        "Protocol": "TCP",
        "TargetType": "alb",
        "Targets": [
          {
            "Id": {
              "Ref": "ApplicationLoadBalancer"
            },
            "Port": 80
          }
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-vpc-id"
          }
        }
      },
      "DependsOn": [
        "ApplicationLoadBalancer",
        "ApplicationLoadBalancerListener80"
      ]
    },
    "NetworkLoadBalancerListener80": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "NetworkLoadBalancer"
        },
        "Port": 80,
        "Protocol": "TCP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "NetworkLoadBalancerTargetGroup80"
            }
          }
        ]
      }
    },
    "NetworkLoadBalancerTargetGroup443": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${BaseName}-nlb-target-group-443"
        },
        "Port": 443,
        "Protocol": "TCP",
        "TargetType": "alb",
        "Targets": [
          {
            "Id": {
              "Ref": "ApplicationLoadBalancer"
            },
            "Port": 443
          }
        ],
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${BaseName}-vpc-id"
          }
        }
      },
      "DependsOn": [
        "ApplicationLoadBalancer",
        "ApplicationLoadBalancerListener443"
      ]
    },
    "NetworkLoadBalancerListener443": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "NetworkLoadBalancer"
        },
        "Port": 443,
        "Protocol": "TCP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "NetworkLoadBalancerTargetGroup443"
            }
          }
        ]
      }
    }
  }
}