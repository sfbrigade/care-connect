server: npm run dev -w server -- --port 3000
client: npm run dev -w client -- --host --port 3333
forms: npm run build:forms:watch -w server
prisma: npm run prisma:studio -w server
storybook: npm run storybook -w client
worker: npm run worker:dev -w server
pgboss-ui: PGBOSS_DATABASE_URL=$DATABASE_URL npx pg-boss-admin-dashboard --port 8671 --no-browser
