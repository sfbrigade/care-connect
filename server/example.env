# Bearer token for GET /api/arrests (SFPD daily-arrests integration).
# Generate with: openssl rand -hex 32
ARRESTS_API_KEY=
# ID scanning (person details). Uses Claude on Bedrock.
# IAM user needs "bedrock:InvokeModel" permission.
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=us-west-2
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEYPAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY=
# Address autocomplete + geocoding.
# IAM user needs "geo-places:Suggest", "geo-places:ReverseGeocode", and "geo-places:Geocode" permissions.
AWS_LOCATION_ACCESS_KEY_ID=
AWS_LOCATION_SECRET_ACCESS_KEY=
AWS_LOCATION_REGION=
# Voice transcription (behavioral observations).
# IAM user needs "transcribe:StartStreamTranscription" permission.
AWS_TRANSCRIBE_ACCESS_KEY_ID=
AWS_TRANSCRIBE_SECRET_ACCESS_KEY=
AWS_TRANSCRIBE_REGION=us-west-2
# Optional: custom vocabulary name for domain-specific terms (law enforcement, drugs, SF streets).
# If set, the vocabulary must exist in your AWS account. See scripts/update-transcribe-vocabulary.sh.
AWS_TRANSCRIBE_VOCABULARY_NAME=care-connect-vocabulary
AWS_S3_ACCESS_KEY_ID=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_REGION=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_SIGNER_ENDPOINT=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_REGION=
AWS_SES_SECRET_ACCESS_KEY=
BASE_URL=http://localhost:3333
# Bearer token for GET /api/status/capacity (external dashboard consumer).
# Generate with: openssl rand -hex 32
CAPACITY_API_KEY=
DATABASE_URL=
GEOCODE_RATE_LIMIT_MS=1100
SESSION_SECRET=f0d10894891af0dd21871df84e613ba648c2a21995266fd5cb663bff7de9147c
SMTP_ENABLED=true
SMTP_FROM_EMAIL_ADDRESS=no-reply@example.com
SMTP_REPLY_TO_EMAIL_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME="CareConnect"
EMAIL_SUBJECT_TITLE="CareConnect"
EMAIL_SITE_TITLE="City and County of San Francisco: CareConnect"
EMAIL_BASE_URL=https://careconnect.sf.gov
# Web Push (VAPID). Generate the key pair with: cd server && npx web-push generate-vapid-keys
# Set VAPID_EMAIL to a mailto: address for your org (required by the VAPID spec).
# Copy the generated public key into BOTH VAPID_PUBLIC_KEY (used server-side to sign pushes)
# and VITE_VAPID_PUBLIC_KEY (baked into the client bundle by Vite — VITE_ prefix required).
# The private key is server-only; never expose it to the client.
VAPID_EMAIL=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_FEATURE_REGISTRATION=true
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_SITE_TITLE="Care Connect"
