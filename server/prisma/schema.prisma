// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator erd {
  provider = "prisma-erd-generator"
  output = "./ERD.md"
  theme = "default"
  includeRelationFromFields = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [citext]
}

enum FacilityType {
  DIDO
  LESC
}

enum FacilityStatus {
  CLOSED
  OPEN_NOT_ACCEPTING
  OPEN_ACCEPTING
}

enum FacilityUpdateMethod {
  INTEGRATION
  API
  MANUAL
  AUTOMATED_CALL
  AUTOMATED_TEXT
  WHITEBOARD
  OTHER
}

enum FacilityEligibilityType {
  AGE
  GENDER
  AMBULATORY
  MOBILITY_DEVICES
  ADL_INDEPENDENT
  HOUSING_STATUS
  NEIGHBORHOOD
  SEXUAL_ORIENTATION
  RACE
  LANGUAGE
  PETS
  BELONGINGS
  OTHER
}

enum BedHoldStatus {
  ACTIVE
  EXTENDED
  CANCELLED
  EXPIRED
  TRANSFERRED
}

enum BedType {
  BED
  CHAIR
}

model Organization {
  id                           String                  @id
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  units                        Unit[]
  titles                       Title[]
  invites                      Invite[]
  users                        User[]
}

model Unit {
  id                           String
  organization                 Organization            @relation(fields: [organizationId], references: [id])
  organizationId               String
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  users                        User[]

  @@id(name: "unitId", [id, organizationId])
}

model Title {
  id                           String
  organization                 Organization            @relation(fields: [organizationId], references: [id])
  organizationId               String
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  invites                      Invite[]
  users                        User[]

  @@id(name: "titleId", [id, organizationId])
}

model User {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String
  lastName                     String
  email                        String                  @unique @db.Citext
  picture                      String?
  isAdmin                      Boolean                 @default(false)
  organization                 Organization?           @relation(fields: [organizationId], references: [id])
  organizationId               String?
  title                        Title?                  @relation(fields: [organizationId, titleId], references: [organizationId, id])
  titleId                      String?
  unit                         Unit?                   @relation(fields: [organizationId, unitId], references: [organizationId, id])
  unitId                       String?
  hashedPassword               String
  deactivatedAt                DateTime?
  passwordResetToken           String?                 @unique @db.Uuid
  passwordResetExpiresAt       DateTime?
  badgeNumber                  String?
  prop115Certified             Boolean                 @default(false)
  updatedAt                    DateTime                @updatedAt
  createdAt                    DateTime                @default(now())

  bedHoldsCreated              BedHold[]               @relation("CreatedBy")
  bedHoldsCancelled            BedHold[]               @relation("CancelledBy")
  bedHoldsTransferred          BedHold[]               @relation("TransferredBy")
  bedStatusesCreated           BedStatus[]             @relation("CreatedBy")
  bedStatusesUpdated           BedStatus[]             @relation("UpdatedBy")
  bedStatusUpdatesCreated      BedStatusUpdate[]
  facilitiesCreated            Facility[]              @relation("CreatedBy")
  facilitiesUpdated            Facility[]              @relation("UpdatedBy")
  facilityStatusReasonsCreated FacilityStatusReason[]  @relation("CreatedBy")
  facilityStatusReasonsUpdated FacilityStatusReason[]  @relation("UpdatedBy")
  facilityUpdatesCreated       FacilityUpdate[]
  incidentsCreated             Incident[]              @relation("CreatedBy")
  invitesCreated               Invite[]                @relation("CreatedBy")
  invitesAccepted              Invite[]                @relation("AcceptedBy")
  invitesRevoked               Invite[]                @relation("RevokedBy")
  organizationsCreated         Organization[]          @relation("CreatedBy")
  titlesCreated                Title[]                 @relation("CreatedBy")
  unitsCreated                 Unit[]                  @relation("CreatedBy") 
}

model Invite {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String
  lastName                     String
  email                        String                  @db.Citext
  message                      String?
  organization                 Organization?           @relation(fields: [organizationId], references: [id])
  organizationId               String?
  title                        Title?                  @relation(fields: [organizationId, titleId], references: [organizationId, id])
  titleId                      String?
  badgeNumber                  String?
  prop115Certified             Boolean                 @default(false)
  updatedAt                    DateTime                @updatedAt
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  acceptedAt                   DateTime?
  acceptedBy                   User?                   @relation("AcceptedBy", fields: [acceptedById], references: [id])
  acceptedById                 String?                 @db.Uuid
  revokedAt                    DateTime?
  revokedBy                    User?                   @relation("RevokedBy", fields: [revokedById], references: [id])
  revokedById                  String?                 @db.Uuid
}

model Facility {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  type                         FacilityType            @default(DIDO)
  serviceType                  ServiceType             @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId                String
  status                       FacilityStatus          @default(OPEN_ACCEPTING)
  statusReason                 FacilityStatusReason?   @relation(fields: [statusReasonId], references: [id])
  statusReasonId               String?
  statusOther                  String?
  updateMethod                 FacilityUpdateMethod    @default(MANUAL)
  updateNotes                  String?

  subdomain                    String?                 @db.Citext @unique
  description                  String?
  phone                        String?
  email                        String?
  website                      String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  neighborhood                 String?
  nstDistrict                  String?
  latitude                     Decimal?                @db.Decimal(9, 6)
  longitude                    Decimal?                @db.Decimal(9, 6)
  timezone                     String?
  isActive                     Boolean                 @default(true)
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy",fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  amenities                    Amenity[]
  bedHolds                     BedHold[]
  bedStatuses                  BedStatus[]
  contacts                     FacilityContact[]
  eligibility                  FacilityEligibility[]
  updates                      FacilityUpdate[]
}

model FacilityUpdate {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  status                       FacilityStatus
  statusReasonId               String?
  statusReason                 FacilityStatusReason?   @relation(fields: [statusReasonId], references: [id])
  statusOther                  String?
  updateMethod                 FacilityUpdateMethod    @default(MANUAL)
  updateNotes                  String?
  updatedAt                    DateTime                @default(now())
  updatedBy                    User                    @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid
}

model FacilityStatusReason {
  id                           String                  @id
  type                         FacilityType?
  description                  String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy",fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  facilities                   Facility[]
  facilityUpdates              FacilityUpdate[]
}

model FacilityContact {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  name                         String
  role                         String?
  email                        String?
  phone                        String?
  notes                        String?
  isPrimary                    Boolean                 @default(false)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
}

model Amenity {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String                  @unique
  description                  String?
  facilities                   Facility[]
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
}

model ServiceType {
  id                           String                  @id
  name                         String
  description                  String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  facilities                   Facility[]
  bedHolds                     BedHold[]
}

model BedStatus {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  type                         BedType                 @default(BED)
  capacity                     Int                     @default(0)
  unavailableUnoccupied        Int                     @default(0)
  unavailableOccupied          Int                     @default(0)
  occupied                     Int                     @default(0)
  holds                        Int                     @default(0)
  available                    Int                     @default(0)
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updateMethod                 FacilityUpdateMethod    @default(MANUAL)
  updateNotes                  String?
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy",fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  updates                      BedStatusUpdate[]
}

model BedStatusUpdate {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bedStatus                    BedStatus               @relation(fields: [bedStatusId], references: [id], onDelete: Cascade)
  bedStatusId                  String                  @db.Uuid
  capacity                     Int                     @default(0)
  unavailableUnoccupied        Int                     @default(0)
  unavailableOccupied          Int                     @default(0)
  occupied                     Int                     @default(0)
  holds                        Int                     @default(0)
  available                    Int                     @default(0)
  updateMethod                 FacilityUpdateMethod    @default(MANUAL)
  updateNotes                  String?
  updatedAt                    DateTime                @default(now())
  updatedBy                    User                    @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid  
}

model FacilityEligibility {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  type                         FacilityEligibilityType
  value                        String?
  notes                        String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([facilityId, type])
}

model Client {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String
  lastName                     String?
  middleInitial                String?
  dateOfBirth                  DateTime?
  sex                          String?
  race                         String?
  address                      String?
  driverLicense                String?
  localId                      String?
  personallyIdentifiable       String?
  description                  String?
  pets                         String?
  qualifications               Json?
  notes                        String?
  bedHolds                     BedHold[]
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
}

model BedHold {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  serviceType                  ServiceType             @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  serviceTypeId                String
  client                       Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId                     String?                 @db.Uuid
  incident                     Incident?               @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  incidentId                   String?                 @db.Uuid
  bedsRequested                Int
  expiresAt                    DateTime
  status                       BedHoldStatus           @default(ACTIVE)
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById                  String                  @db.Uuid
  cancelledAt                  DateTime?
  cancelledBy                  User?                   @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledById                String?                 @db.Uuid
  extendedAt                   DateTime?
  transferredAt                DateTime?
  transferredBy                User?                   @relation("TransferredBy", fields: [transferredById], references: [id], onDelete: SetNull)
  transferredById              String?                 @db.Uuid
  transferToken                String?                 @unique
  transferTokenExpiresAt       DateTime?
  notes                        String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([facilityId])
  @@index([expiresAt])
  @@index([status])
  @@index([incidentId])
}

model Incident {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId                   String                  @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  arrivedAt                    DateTime?
  leftAt                       DateTime?
  completedAt                  DateTime?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  latitude                     Decimal?                @db.Decimal(9, 6)
  longitude                    Decimal?                @db.Decimal(9, 6)
  arrestedAt                   DateTime?
  cadNumber                    String?
  supervisorBadgeNumber        String?
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById                  String                  @db.Uuid
  createdByOrganization        Organization?           @relation("CreatedByOrganization", fields: [createdByOrganizationId], references: [id], onDelete: Restrict)
  createdByOrganizationId      String?
  createdByTitle               Title?                  @relation("CreatedByTitle", fields: [createdByTitleId], references: [id], onDelete: Restrict)
  createdByTitleId             String?
  createdByUnit                Unit?                   @relation("CreatedByUnit", fields: [createdByUnitId], references: [id], onDelete: Restrict)
  createdByUnitId              String?
  createdByBadgeNumber         String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([cadNumber])

  bedHolds                     BedHold[]
}

model Feedback {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message                      String
  userEmail                    String?
  userAgent                    String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([createdAt])
}
