// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["nativeDistinct","postgresqlExtensions"]
}

generator erd {
  provider = "prisma-erd-generator"
  output = "./ERD.md"
  theme = "default"
  includeRelationFromFields = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [citext]
}

enum BedTypeEnum {
  BED
  CHAIR
}

enum TernaryEnum {
  YES
  NO
  UNKNOWN
}

enum FacilityTypeEnum {
  DIDO
  LESC
}

enum FacilityStatusEnum {
  CLOSED
  OPEN_NOT_ACCEPTING
  OPEN_ACCEPTING
}

enum FacilityUpdateMethodEnum {
  INTEGRATION
  API
  MANUAL
  AUTOMATED_CALL
  AUTOMATED_TEXT
  WHITEBOARD
  OTHER
}

enum FacilityEligibilityTypeEnum {
  AGE
  GENDER
  AMBULATORY
  MOBILITY_DEVICES
  ADL_INDEPENDENT
  HOUSING_STATUS
  NEIGHBORHOOD
  SEXUAL_ORIENTATION
  RACE
  LANGUAGE
  PETS
  BELONGINGS
  OTHER
}

enum HoldStatusEnum {
  ACTIVE
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PropertyEnum {
  NONE
  SMALL
  MEDIUM
  LARGE
}

enum DrugTypeEnum {
  INTOXICATING_LIQUOR
  DRUG
  TOLUENE
  COMBINATION
}

enum EncounteredViaEnum {
  ON_VIEW
  DISPATCHED
}

enum RaceEnum {
  WHITE
  BLACK
  HISPANIC
  ASIAN
  OTHER
  UNKNOWN
}

enum SexEnum {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum RoleEnum {
  FIELD
  CUSTODY
  CARE
}

enum SubjectStatusEnum {
  DETAINED
  ONSITE_AWAITING_TRANSFER
  AWAITING_INTAKE
  READY_FOR_INTAKE
  FAILED_INTAKE
  ADMITTED
  IN_CHAIR
  RELEASED
  EXITED
}

model Organization {
  id                           String                  @id
  name                         String
  defaultRoles                 RoleEnum[]              @default([])
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  deflections                  Deflection[]
  incidents                    Incident[]
  invites                      Invite[]
  titles                       Title[]
  units                        Unit[]
  users                        User[]
}

model Unit {
  id                           String
  organization                 Organization            @relation(fields: [organizationId], references: [id])
  organizationId               String
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  deflections                  Deflection[]
  incidents                    Incident[]
  users                        User[]

  @@id(name: "unitId", [id, organizationId])
}

model Title {
  id                           String
  organization                 Organization            @relation(fields: [organizationId], references: [id])
  organizationId               String
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  deflections                  Deflection[]
  incidents                    Incident[]
  invites                      Invite[]
  users                        User[]

  @@id(name: "titleId", [id, organizationId])
}

model User {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String
  lastName                     String
  email                        String                  @unique @db.Citext
  picture                      String?
  isAdmin                      Boolean                 @default(false)
  roles                        RoleEnum[]              @default([])
  organization                 Organization?           @relation(fields: [organizationId], references: [id])
  organizationId               String?
  title                        Title?                  @relation(fields: [organizationId, titleId], references: [organizationId, id])
  titleId                      String?
  unit                         Unit?                   @relation(fields: [organizationId, unitId], references: [organizationId, id])
  unitId                       String?
  hashedPassword               String
  deactivatedAt                DateTime?
  passwordResetToken           String?                 @unique @db.Uuid
  passwordResetExpiresAt       DateTime?
  badgeNumber                  String?
  prop115Certified             Boolean                 @default(false)
  updatedAt                    DateTime                @updatedAt
  createdAt                    DateTime                @default(now())

  bedTypesCreated              BedType[]               @relation("CreatedBy")
  bedTypesUpdated              BedType[]               @relation("UpdatedBy")
  bedTypeUpdatesCreated        BedTypeUpdate[]
  deflectionCancelReasonsCreated DeflectionCancelReason[] @relation("CreatedBy")
  deflectionCancelReasonsUpdated DeflectionCancelReason[] @relation("UpdatedBy")
  deflectionDetailCategoriesCreated DeflectionDetailCategory[] @relation("CreatedBy")
  deflectionDetailCategoriesUpdated DeflectionDetailCategory[] @relation("UpdatedBy")
  deflectionDetailsCreated     DeflectionDetail[]      @relation("CreatedBy")
  deflectionDetailsUpdated     DeflectionDetail[]      @relation("UpdatedBy")
  deflectionReleaseReasonsCreated DeflectionReleaseReason[] @relation("CreatedBy")
  deflectionReleaseReasonsUpdated DeflectionReleaseReason[] @relation("UpdatedBy")
  deflectionRefusalReasonsCreated DeflectionRefusalReason[] @relation("CreatedBy")
  deflectionRefusalReasonsUpdated DeflectionRefusalReason[] @relation("UpdatedBy")
  deflectionExitDestinationsCreated DeflectionExitDestination[] @relation("CreatedBy")
  deflectionExitDestinationsUpdated DeflectionExitDestination[] @relation("UpdatedBy")
  deflectionExitHousingStatusesCreated DeflectionExitHousingStatus[] @relation("CreatedBy")
  deflectionExitHousingStatusesUpdated DeflectionExitHousingStatus[] @relation("UpdatedBy")
  deflectionsCancelled         Deflection[]            @relation("CancelledBy")
  deflectionsCreated           Deflection[]            @relation("CreatedBy")
  deflectionsTransferred       Deflection[]            @relation("TransferredBy")
  deflectionsAdmitted          Deflection[]            @relation("AdmittedBy")
  deflectionsRejected          Deflection[]            @relation("RejectedBy")
  deflectionsReleased          Deflection[]            @relation("ReleasedBy")
  deflectionsExited            Deflection[]            @relation("ExitedBy")
  deflectionUpdatesCreated     DeflectionUpdate[]
  facilitiesCreated            Facility[]              @relation("CreatedBy")
  facilitiesUpdated            Facility[]              @relation("UpdatedBy")
  facilityStatusReasonsCreated FacilityStatusReason[]  @relation("CreatedBy")
  facilityStatusReasonsUpdated FacilityStatusReason[]  @relation("UpdatedBy")
  facilityUpdatesCreated       FacilityUpdate[]
  incidentsCreated             Incident[]              @relation("CreatedBy")
  incidentsUpdated             Incident[]              @relation("UpdatedBy")
  invitesCreated               Invite[]                @relation("CreatedBy")
  invitesAccepted              Invite[]                @relation("AcceptedBy")
  invitesRevoked               Invite[]                @relation("RevokedBy")
  organizationsCreated         Organization[]          @relation("CreatedBy")
  propertyPhotosCreated        PropertyPhoto[]         @relation("CreatedBy")
  propertyPhotosUpdated        PropertyPhoto[]         @relation("UpdatedBy")
  titlesCreated                Title[]                 @relation("CreatedBy")
  unitsCreated                 Unit[]                  @relation("CreatedBy") 
}

model Invite {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String
  lastName                     String
  email                        String                  @db.Citext
  message                      String?
  organization                 Organization?           @relation(fields: [organizationId], references: [id])
  organizationId               String?
  title                        Title?                  @relation(fields: [organizationId, titleId], references: [organizationId, id])
  titleId                      String?
  badgeNumber                  String?
  prop115Certified             Boolean                 @default(false)
  updatedAt                    DateTime                @updatedAt
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  acceptedAt                   DateTime?
  acceptedBy                   User?                   @relation("AcceptedBy", fields: [acceptedById], references: [id])
  acceptedById                 String?                 @db.Uuid
  revokedAt                    DateTime?
  revokedBy                    User?                   @relation("RevokedBy", fields: [revokedById], references: [id])
  revokedById                  String?                 @db.Uuid
}

model Facility {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  type                         FacilityTypeEnum        @default(DIDO)
  serviceType                  ServiceType             @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId                String
  status                       FacilityStatusEnum      @default(OPEN_ACCEPTING)
  statusReason                 FacilityStatusReason?   @relation(fields: [statusReasonId], references: [id])
  statusReasonId               String?
  statusOther                  String?
  updateMethod                 FacilityUpdateMethodEnum @default(MANUAL)
  updateNotes                  String?

  subdomain                    String?                 @db.Citext @unique
  description                  String?
  phone                        String?
  email                        String?
  website                      String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  neighborhood                 String?
  nstDistrict                  String?
  latitude                     Decimal?                @db.Decimal(9, 6)
  longitude                    Decimal?                @db.Decimal(9, 6)
  timezone                     String?
  isActive                     Boolean                 @default(true)
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy",fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  amenities                    Amenity[]
  bedTypes                     BedType[]
  bedTypeUpdates               BedTypeUpdate[]
  contacts                     FacilityContact[]
  deflections                  Deflection[]
  eligibility                  FacilityEligibility[]
  incidents                    Incident[]
  updates                      FacilityUpdate[]
}

model FacilityUpdate {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  status                       FacilityStatusEnum
  statusReasonId               String?
  statusReason                 FacilityStatusReason?   @relation(fields: [statusReasonId], references: [id])
  statusOther                  String?
  updateMethod                 FacilityUpdateMethodEnum @default(MANUAL)
  updateNotes                  String?
  updatedAt                    DateTime                @default(now())
  updatedBy                    User                    @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid
}

model FacilityStatusReason {
  id                           String                  @id
  type                         FacilityTypeEnum?
  description                  String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy",fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  facilities                   Facility[]
  facilityUpdates              FacilityUpdate[]
}

model FacilityContact {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  name                         String
  role                         String?
  email                        String?
  phone                        String?
  notes                        String?
  isPrimary                    Boolean                 @default(false)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
}

model Amenity {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String                  @unique
  description                  String?
  facilities                   Facility[]
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
}

model ServiceType {
  id                           String                  @id
  name                         String
  description                  String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  facilities                   Facility[]
}

model BedType {
  id                           String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  type                         BedTypeEnum             @default(BED)
  capacity                     Int                     @default(0)
  unavailableUnoccupied        Int                     @default(0)
  unavailableOccupied          Int                     @default(0)
  occupied                     Int                     @default(0)
  holds                        Int                     @default(0)
  available                    Int                     @default(0)
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updateMethod                 FacilityUpdateMethodEnum @default(MANUAL)
  updateNotes                  String?
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy",fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  @@id(name: "bedTypeId", [id, facilityId])

  deflections                  Deflection[]
  updates                      BedTypeUpdate[]
}

model BedTypeUpdate {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid  
  bedType                      BedType                 @relation(fields: [bedTypeId, facilityId], references: [id, facilityId])
  bedTypeId                    String                  @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id])
  facilityId                   String                  @db.Uuid
  capacity                     Int                     @default(0)
  unavailableUnoccupied        Int                     @default(0)
  unavailableOccupied          Int                     @default(0)
  occupied                     Int                     @default(0)
  holds                        Int                     @default(0)
  available                    Int                     @default(0)
  updateMethod                 FacilityUpdateMethodEnum @default(MANUAL)
  updateNotes                  String?
  updatedAt                    DateTime                @default(now())
  updatedBy                    User                    @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid  
}

model FacilityEligibility {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId                   String                  @db.Uuid
  type                         FacilityEligibilityTypeEnum
  value                        String?
  notes                        String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([facilityId, type])
}

model Subject {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String?
  lastName                     String?
  middleInitial                String?
  dateOfBirth                  DateTime?               @db.Date
  sex                          SexEnum?
  race                         RaceEnum?
  driverLicense                String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  localId                      String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  deflections                  Deflection[]
}

model Deflection {
  id                           Int                     @id @default(autoincrement())
  facility                     Facility                @relation(fields: [facilityId], references: [id])
  facilityId                   String                  @db.Uuid
  incident                     Incident                @relation(fields: [facilityId, incidentId], references: [facilityId, id])
  incidentId                   Int
  bedType                      BedType                 @relation(fields: [facilityId, bedTypeId], references: [facilityId, id])
  bedTypeId                    String                  @db.Uuid 
  subject                      Subject?                @relation(fields: [subjectId], references: [id])
  subjectId                    String?                 @db.Uuid
  subjectStatus                SubjectStatusEnum       @default(DETAINED)
  narcoticsSubstance           Boolean?
  narcoticsParaphernalia       Boolean?
  drugUseEvidence              Boolean?
  drugType                     DrugTypeEnum?
  behavior                     String?
  property                     PropertyEnum?
  propertyDetails              String?
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  expiresAt                    DateTime                @default(dbgenerated("(now() + '01:00:00'::interval)"))
  completedAt                  DateTime?
  status                       HoldStatusEnum          @default(ACTIVE)
  extensionCount               Int                     @default(0)
  cancelReason                 DeflectionCancelReason? @relation(fields: [cancelReasonId], references: [id])
  cancelReasonId               String?
  cancelledAt                  DateTime?
  cancelledBy                  User?                   @relation("CancelledBy", fields: [cancelledById], references: [id])
  cancelledById                String?                 @db.Uuid
  transferredAt                DateTime?
  transferredBy                User?                   @relation("TransferredBy", fields: [transferredById], references: [id])
  transferredById              String?                 @db.Uuid
  transferredByBadgeNumber     String?
  transferredByProp115Certified Boolean?
  transferredByOrganizationId  String?
  transferredByOrganization    Organization?           @relation(fields: [transferredByOrganizationId], references: [id])
  transferredByUnitId          String?
  transferredByUnit            Unit?                   @relation(fields: [transferredByOrganizationId, transferredByUnitId], references: [organizationId, id])
  transferredByTitleId         String?
  transferredByTitle           Title?                  @relation(fields: [transferredByOrganizationId, transferredByTitleId], references: [organizationId, id])
  admittedAt                   DateTime?
  admittedBy                   User?                   @relation("AdmittedBy", fields: [admittedById], references: [id])
  admittedById                 String?                 @db.Uuid
  rejectedAt                   DateTime?
  rejectedBy                   User?                   @relation("RejectedBy", fields: [rejectedById], references: [id])
  rejectedById                 String?                 @db.Uuid
  releasedAt                   DateTime?
  releasedBy                   User?                   @relation("ReleasedBy", fields: [releasedById], references: [id])
  releasedById                 String?                 @db.Uuid
  releaseReason                DeflectionReleaseReason? @relation(fields: [releaseReasonId], references: [id])
  releaseReasonId              String?
  refusalReason                DeflectionRefusalReason? @relation(fields: [refusalReasonId], references: [id])
  refusalReasonId              String?
  exitedAt                     DateTime?
  exitedBy                     User?                   @relation("ExitedBy", fields: [exitedById], references: [id])
  exitedById                   String?                 @db.Uuid
  exitDestination              DeflectionExitDestination? @relation(fields: [exitDestinationId], references: [id])
  exitDestinationId            String?
  exitHousingStatus            DeflectionExitHousingStatus? @relation(fields: [exitHousingStatusId], references: [id])
  exitHousingStatusId          String?
  exitConnectedToCare          TernaryEnum?
  exitSFResident               TernaryEnum?
  updatedAt                    DateTime                @updatedAt

  deflectionDetails            DeflectionDetail[]
  deflectionUpdates            DeflectionUpdate[]
  propertyPhotos               PropertyPhoto[]
}

model DeflectionDetailCategory {
  id                           String                  @id
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedBy                    User?                   @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedById                  String?                 @db.Uuid
  updatedAt                    DateTime                @updatedAt

  deflectionDetails            DeflectionDetail[]
}

model DeflectionDetail {
  id                           String                  @id
  deflectionDetailCategoryId   String
  deflectionDetailCategory     DeflectionDetailCategory @relation(fields: [deflectionDetailCategoryId], references: [id])
  name                         String
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedBy                    User?                   @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedById                  String?                 @db.Uuid
  updatedAt                    DateTime                @updatedAt

  deflections                  Deflection[]
}

model DeflectionUpdate {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deflection                   Deflection              @relation(fields: [deflectionId], references: [id])
  deflectionId                 Int
  status                       HoldStatusEnum?
  expiresAt                    DateTime?
  extensionCount               Int?
  cancelReason                 DeflectionCancelReason? @relation(fields: [cancelReasonId], references: [id])
  cancelReasonId               String?
  subjectStatus                SubjectStatusEnum?
  releaseReason                DeflectionReleaseReason? @relation(fields: [releaseReasonId], references: [id])
  releaseReasonId              String?
  refusalReason                DeflectionRefusalReason? @relation(fields: [refusalReasonId], references: [id])
  refusalReasonId              String?
  exitDestination              DeflectionExitDestination? @relation(fields: [exitDestinationId], references: [id])
  exitDestinationId            String?
  exitHousingStatus            DeflectionExitHousingStatus? @relation(fields: [exitHousingStatusId], references: [id])
  exitHousingStatusId          String?
  exitConnectedToCare          TernaryEnum?
  exitSFResident               TernaryEnum?
  updatedAt                    DateTime                @default(now())
  updatedBy                    User                    @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid
}

model DeflectionCancelReason {
  id                           String                  @id
  name                         String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  deflections                  Deflection[]
  deflectionUpdates            DeflectionUpdate[]
}

model DeflectionReleaseReason {
  id                           String                  @id
  name                         String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  deflections                  Deflection[]
  deflectionUpdates            DeflectionUpdate[]
}

model DeflectionRefusalReason {
  id                           String                  @id
  name                         String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  deflections                  Deflection[]
  deflectionUpdates            DeflectionUpdate[]
}

model DeflectionExitDestination {
  id                           String                  @id
  name                         String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  deflections                  Deflection[]
  deflectionUpdates            DeflectionUpdate[]
}

model DeflectionExitHousingStatus {
  id                           String                  @id
  name                         String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  deflections                  Deflection[]
  deflectionUpdates            DeflectionUpdate[]
}

model PropertyPhoto {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deflection                   Deflection              @relation(fields: [deflectionId], references: [id], onDelete: Cascade)
  deflectionId                 Int
  file                         String
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid
}

model Incident {
  id                           Int                     @unique @default(autoincrement())
  facilityId                   String                  @db.Uuid
  facility                     Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  arrivedAt                    DateTime?
  leftAt                       DateTime?
  completedAt                  DateTime?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  latitude                     Decimal?                @db.Decimal(9, 6)
  longitude                    Decimal?                @db.Decimal(9, 6)
  arrestedAt                   DateTime?
  encounteredVia               EncounteredViaEnum
  cadNumber                    String?
  supervisorBadgeNumber        String?
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById                  String                  @db.Uuid
  createdByOrganization        Organization?           @relation(fields: [createdByOrganizationId], references: [id], onDelete: Restrict)
  createdByOrganizationId      String?
  createdByTitle               Title?                  @relation(fields: [createdByOrganizationId, createdByTitleId], references: [organizationId, id], onDelete: Restrict)
  createdByTitleId             String?
  createdByUnit                Unit?                   @relation(fields: [createdByOrganizationId, createdByUnitId], references: [organizationId, id], onDelete: Restrict)
  createdByUnitId              String?
  createdByBadgeNumber         String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedById                  String                  @db.Uuid

  @@id([id, facilityId])
  @@index([cadNumber])

  deflections                  Deflection[]
}

model Feedback {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message                      String
  userEmail                    String?
  userAgent                    String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([createdAt])
}
