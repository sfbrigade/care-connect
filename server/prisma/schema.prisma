// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["nativeDistinct", "postgresqlExtensions"]
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "./ERD.md"
  theme                     = "default"
  includeRelationFromFields = true
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum BedTypeEnum {
  BED
  CHAIR
}

enum TernaryEnum {
  YES
  NO
  UNKNOWN
}

enum SFResidentEnum {
  YES
  NO
  UNKNOWN
  DECLINED_CONSENT
}

enum FacilityTypeEnum {
  DIDO
  LESC
}

enum FacilityStatusEnum {
  CLOSED
  OPEN_NOT_ACCEPTING
  OPEN_ACCEPTING
}

enum FacilityUpdateMethodEnum {
  INTEGRATION
  API
  MANUAL
  AUTOMATED_CALL
  AUTOMATED_TEXT
  WHITEBOARD
  OTHER
}

enum FacilityEligibilityTypeEnum {
  AGE
  GENDER
  AMBULATORY
  MOBILITY_DEVICES
  ADL_INDEPENDENT
  HOUSING_STATUS
  NEIGHBORHOOD
  SEXUAL_ORIENTATION
  RACE
  LANGUAGE
  PETS
  BELONGINGS
  OTHER
}

enum HoldStatusEnum {
  ACTIVE
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PropertyEnum {
  NONE
  SMALL
  MEDIUM
  LARGE
}

enum PropertyNotReturnedReasonEnum {
  ABANDONED
  DESTROYED
  OTHER
}

enum ChargeTypeEnum {
  RWS_647F
  HS_11550
}

enum DrugTypeEnum {
  ALCOHOL
  HEROIN
  FENTANYL
  COCAINE
  METH
  MEDS
  OTHER
}

enum EncounteredViaEnum {
  ON_VIEW
  DISPATCHED
}

enum RaceEnum {
  WHITE
  BLACK
  HISPANIC
  ASIAN
  OTHER
  UNKNOWN
}

enum SexEnum {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PreferredLanguageEnum {
  ARABIC
  ARMENIAN
  BASQUE
  BOSNIAN
  CHINESE_CANTONESE
  CHINESE_MANDARIN
  DANISH
  FIJIAN
  FILIPINO_TAGALOG
  FRENCH
  GAELIC
  GERMAN
  GREEK
  GUJARATI
  HINDI
  IGBO
  ILONGGO
  ITALIAN
  JAPANESE
  KOREAN
  LAOTIAN
  MANDARIN
  POLISH
  PORTUGUESE
  PUNJABI
  ROMANIAN
  RUSSIAN
  SAMOAN
  SERBIAN
  SPANISH
  SWEDISH
  THAI
  TOISANESE
  URDU
  VIETNAMESE
}

enum DeflectionCancelReasonEnum {
  BEHAVIORAL_HEALTH_EVALUATION
  JAIL
  HOSPITAL
  RELEASE_ON_SCENE
  NO_CHAIRS_AVAILABLE
  STAFFING_SHORTAGE
}

enum DeflectionReleaseReasonEnum {
  SOBERED
  MEDICAL_ISSUE
  BEHAVIORAL_HEALTH_EVALUATION
  OTHER
  DEATH_IN_FACILITY
  DEATH_IN_CUSTODY
}

enum DeflectionRefusalReasonEnum {
  AGGRESSIVE_BEHAVIOR
  MEDICAL_ISSUE
}

enum DeflectionExitDestinationEnum {
  JAIL
  HOSPITAL
  STREET
  HOME
  SERVICES_NON_HOSPITAL
  DECLINED_CONSENT
  OTHER
}

enum DeflectionExitHousingStatusEnum {
  PERMANENT
  SHELTERED
  TEMPORARY
  UNKNOWN
  DECLINED_CONSENT
}

enum FacilityStatusReasonEnum {
  BUILDING_ISSUE
  SAFETY_LOCKDOWN
  OTHER
  SFSO_STAFFING
  CONNECTIONS_STAFFING
}

enum BedTypeUnavailableReasonEnum {
  SFSD_STAFFING
  CONTRACTOR_STAFFING
  BUILDING_ISSUE
  SAFETY_LOCKDOWN
  OTHER
}

enum RoleEnum {
  FIELD
  CUSTODY
  CARE
  ORG_ADMIN
  FACILITY_ADMIN
}

enum SubjectStatusEnum {
  DETAINED
  ONSITE_AWAITING_TRANSFER
  AWAITING_INTAKE
  READY_FOR_INTAKE
  FAILED_INTAKE
  IN_MEDICAL_INTAKE
  IN_CHAIR
  RELEASED
  EXITED
  DEATH_IN_FACILITY
  DEATH_IN_CUSTODY
}

// Event types a user can subscribe to for SMS notifications (D7/D8).
enum NotifiableEventEnum {
  NEW_HOLD
  ARRIVAL
  EXIT
}

model Organization {
  id           String     @id
  name         String
  defaultRoles RoleEnum[] @default([])
  createdBy    User       @relation("CreatedBy", fields: [createdById], references: [id])
  createdById  String     @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  deflections         Deflection[]
  incidents           Incident[]
  invites             Invite[]
  titles              Title[]
  units               Unit[]
  users               User[]
  satisfactionSurveys SatisfactionSurvey[]
}

model Unit {
  id             String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  createdBy      User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deflections Deflection[]
  incidents   Incident[]
  users       User[]

  @@id(name: "unitId", [id, organizationId])
}

model Title {
  id             String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  createdBy      User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deflections Deflection[]
  incidents   Incident[]
  invites     Invite[]
  users       User[]

  @@id(name: "titleId", [id, organizationId])
}

model User {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName                    String
  lastName                     String
  email                        String                  @unique @db.Citext
  picture                      String?
  isAdmin                      Boolean                 @default(false)
  roles                        RoleEnum[]              @default([])
  organization                 Organization?           @relation(fields: [organizationId], references: [id])
  organizationId               String?
  title                        Title?                  @relation(fields: [organizationId, titleId], references: [organizationId, id])
  titleId                      String?
  unit                         Unit?                   @relation(fields: [organizationId, unitId], references: [organizationId, id])
  unitId                       String?
  hashedPassword               String
  deactivatedAt                DateTime?
  deletedAt                    DateTime?
  passwordResetToken           String?                 @unique @db.Uuid
  passwordResetExpiresAt       DateTime?
  mfaEnabled                   Boolean                 @default(true)
  mfaCode                      String?
  mfaToken                     String?                 @unique @db.Uuid
  mfaExpiresAt                 DateTime?
  mfaAttempts                  Int                     @default(0)
  mfaLastSentAt                DateTime?
  badgeNumber                  String?
  prop115Certified             Boolean                 @default(false)
  satisfactionSurveyNextEligibleAt DateTime?
  // SMS notifications (D7). phoneVerifiedAt/smsOptedOutAt are server-controlled;
  // phoneNumber is managed only via the phone verification flow (not the generic
  // profile update), so a number can't appear verified without owning it.
  phoneNumber                  String?
  phoneVerifiedAt              DateTime?
  smsConsentAt                 DateTime?
  smsOptedOutAt                DateTime?
  notificationsEnabled         Boolean                 @default(false)
  subscribedEvents             NotifiableEventEnum[]   @default([])
  currentFacilityId            String?                 @db.Uuid
  currentFacility              Facility?               @relation("UsersCurrentFacility", fields: [currentFacilityId], references: [id])
  // Self-managed SMS OTP (D6), mirroring the login-MFA fields. No token: the user
  // is already authenticated, so we key off the session user.
  smsOtpCode                   String?
  smsOtpExpiresAt              DateTime?
  smsOtpAttempts               Int                     @default(0)
  smsOtpLastSentAt             DateTime?
  // SMS enrollment banner dismissal state (cross-device). Subscribe/X →
  // dismissedAt (permanent). "Remind me later" → remindAfter=+24h, capped so it
  // reappears once then is permanent (remindCount).
  smsBannerDismissedAt         DateTime?
  smsBannerRemindAfter         DateTime?
  smsBannerRemindCount         Int                     @default(0)
  // When the one-time "you're subscribed" welcome SMS was sent (null = never).
  smsWelcomedAt                DateTime?
  updatedAt                    DateTime                @updatedAt
  createdAt                    DateTime                @default(now())
  adminSecurityEventsPerformed AdminSecurityEvent[]    @relation("AdminSecurityEventActor")
  adminSecurityEventsTargeting AdminSecurityEvent[]    @relation("AdminSecurityEventTarget")

  bedTypesCreated                      BedType[]                     @relation("CreatedBy")
  bedTypesUpdated                      BedType[]                     @relation("UpdatedBy")
  bedTypeUpdatesCreated                BedTypeUpdate[]
  deflectionsCancelled                 Deflection[]                  @relation("CancelledBy")
  deflectionsCreated                   Deflection[]                  @relation("CreatedBy")
  deflectionsCurrentOfficer            Deflection[]                  @relation("CurrentOfficer")
  deflectionsTransferred               Deflection[]                  @relation("TransferredBy")
  deflectionsMedicalIntakeStarted                  Deflection[]                  @relation("MedicalIntakeStartedBy")
  deflectionsRejected                  Deflection[]                  @relation("RejectedBy")
  deflectionsReleased                  Deflection[]                  @relation("ReleasedBy")
  deflectionsPropertyReturned          Deflection[]                  @relation("PropertyReturnedBy")
  deflectionsExited                    Deflection[]                  @relation("ExitedBy")
  deflectionUpdatesCreated             DeflectionUpdate[]
  facilitiesCreated                    Facility[]                    @relation("CreatedBy")
  facilitiesUpdated                    Facility[]                    @relation("UpdatedBy")
  facilityUpdatesCreated               FacilityUpdate[]
  facilityCheckIns                     FacilityCheckIn[]             @relation("FacilityCheckIns")
  handoffsFrom                         Handoff[]                     @relation("HandoffFrom")
  handoffsTo                           Handoff[]                     @relation("HandoffTo")
  incidentsCreated                     Incident[]                    @relation("CreatedBy")
  incidentsUpdated                     Incident[]                    @relation("UpdatedBy")
  invitesCreated                       Invite[]                      @relation("CreatedBy")
  invitesAccepted                      Invite[]                      @relation("AcceptedBy")
  invitesRevoked                       Invite[]                      @relation("RevokedBy")
  organizationsCreated                 Organization[]                @relation("CreatedBy")
  deflectionDocumentsCreated           DeflectionDocument[]          @relation("CreatedBy")
  deflectionDocumentsUpdated           DeflectionDocument[]          @relation("UpdatedBy")
  propertyPhotosCreated                PropertyPhoto[]               @relation("CreatedBy")
  propertyPhotosUpdated                PropertyPhoto[]               @relation("UpdatedBy")
  titlesCreated                        Title[]                       @relation("CreatedBy")
  unitsCreated                         Unit[]                        @relation("CreatedBy")
}

model Invite {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName        String
  lastName         String
  email            String        @db.Citext
  message          String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  organizationId   String?
  title            Title?        @relation(fields: [organizationId, titleId], references: [organizationId, id])
  titleId          String?
  badgeNumber      String?
  prop115Certified Boolean       @default(false)
  expiresAt        DateTime?
  updatedAt        DateTime      @updatedAt
  createdAt        DateTime      @default(now())
  createdBy        User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdById      String        @db.Uuid
  acceptedAt       DateTime?
  acceptedBy       User?         @relation("AcceptedBy", fields: [acceptedById], references: [id])
  acceptedById     String?       @db.Uuid
  revokedAt        DateTime?
  revokedBy        User?         @relation("RevokedBy", fields: [revokedById], references: [id])
  revokedById      String?       @db.Uuid
}

model Facility {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  type           FacilityTypeEnum         @default(DIDO)
  serviceType    ServiceType              @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId  String
  status         FacilityStatusEnum       @default(OPEN_ACCEPTING)
  statusReason   FacilityStatusReasonEnum?
  statusOther    String?
  updateMethod   FacilityUpdateMethodEnum @default(MANUAL)
  updateNotes    String?

  subdomain    String?  @unique @db.Citext
  description  String?
  phone        String?
  email        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  neighborhood String?
  nstDistrict  String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  timezone     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  createdBy    User     @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById  String   @db.Uuid
  updatedAt    DateTime @updatedAt
  updatedBy    User     @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById  String   @db.Uuid

  amenities        Amenity[]
  bedTypes         BedType[]
  bedTypeUpdates   BedTypeUpdate[]
  contacts         FacilityContact[]
  deflections      Deflection[]
  eligibility      FacilityEligibility[]
  facilityCheckIns FacilityCheckIn[]
  incidents        Incident[]
  updates          FacilityUpdate[]
  usersCurrentlyPresent User[]        @relation("UsersCurrentFacility")
}

model FacilityUpdate {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility       Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     String                   @db.Uuid
  status         FacilityStatusEnum
  statusReason   FacilityStatusReasonEnum?
  statusOther    String?
  updateMethod   FacilityUpdateMethodEnum @default(MANUAL)
  updateNotes    String?
  updatedAt      DateTime                 @default(now())
  updatedBy      User                     @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById    String                   @db.Uuid
}


model FacilityContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String   @db.Uuid
  name       String
  role       String?
  email      String?
  phone      String?
  notes      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Amenity {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique
  description String?
  facilities  Facility[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ServiceType {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facilities Facility[]
}

model AdminSecurityEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action       String
  metadata     Json?
  actor        User     @relation("AdminSecurityEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorUserId  String   @db.Uuid
  target       User     @relation("AdminSecurityEventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetUserId String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model BedType {
  id                    String                    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility              Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId            String                    @db.Uuid
  type                  BedTypeEnum               @default(BED)
  capacity              Int                       @default(0)
  unavailableUnoccupied Int                       @default(0)
  unavailableOccupied   Int                       @default(0)
  occupied              Int                       @default(0)
  holds                 Int                       @default(0)
  inTransit             Int                       @default(0)
  available             Int                       @default(0)
  createdAt             DateTime                  @default(now())
  createdBy             User                      @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById           String                    @db.Uuid
  unavailableReason     BedTypeUnavailableReasonEnum?
  unavailableOther      String?
  updateMethod          FacilityUpdateMethodEnum  @default(MANUAL)
  updateNotes           String?
  updatedAt             DateTime                  @updatedAt
  updatedBy             User                      @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById           String                    @db.Uuid

  deflections Deflection[]
  updates     BedTypeUpdate[]

  @@id(name: "bedTypeId", [id, facilityId])
}

model BedTypeUpdate {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bedType               BedType                   @relation(fields: [bedTypeId, facilityId], references: [id, facilityId])
  bedTypeId             String                    @db.Uuid
  facility              Facility                  @relation(fields: [facilityId], references: [id])
  facilityId            String                    @db.Uuid
  capacity              Int                       @default(0)
  unavailableUnoccupied Int                       @default(0)
  unavailableOccupied   Int                       @default(0)
  occupied              Int                       @default(0)
  holds                 Int                       @default(0)
  inTransit             Int                       @default(0)
  available             Int                       @default(0)
  unavailableReason     BedTypeUnavailableReasonEnum?
  unavailableOther      String?
  updateMethod          FacilityUpdateMethodEnum  @default(MANUAL)
  updateNotes           String?
  updatedAt             DateTime                  @default(now())
  updatedBy             User                      @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById           String                    @db.Uuid
}

model FacilityEligibility {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facility   Facility                    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String                      @db.Uuid
  type       FacilityEligibilityTypeEnum
  value      String?
  notes      String?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@index([facilityId, type])
}

model Subject {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// @pii
  firstName                    String?
  /// @pii
  lastName                     String?
  /// @pii
  middleInitial                String?
  /// @pii
  dateOfBirth                  DateTime?               @db.Date
  /// @pii
  sex                          SexEnum?
  /// @pii
  race                         RaceEnum?
  /// @pii
  driverLicense                String?
  /// @pii
  preferredLanguage            PreferredLanguageEnum?
  /// @pii
  addressLine1                 String?
  /// @pii
  addressLine2                 String?
  /// @pii
  city                         String?
  /// @pii
  state                        String?
  /// @pii
  postalCode                   String?
  /// @pii
  localId                      String?
  anonymizedAt                 DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  deflections                  Deflection[]

  @@index([anonymizedAt])
}

model Deflection {
  id                             Int                            @id @default(autoincrement())
  facility                       Facility                       @relation(fields: [facilityId], references: [id])
  facilityId                     String                         @db.Uuid
  incident                       Incident                       @relation(fields: [facilityId, incidentId], references: [facilityId, id])
  incidentId                     Int
  bedType                        BedType                        @relation(fields: [facilityId, bedTypeId], references: [facilityId, id])
  bedTypeId                      String                         @db.Uuid
  subject                        Subject?                       @relation(fields: [subjectId], references: [id])
  subjectId                      String?                        @db.Uuid
  subjectStatus                  SubjectStatusEnum              @default(DETAINED)
  narcoticsSubstance             Boolean?
  narcoticsParaphernalia         Boolean?
  drugUseEvidence                Boolean?
  drugType                       DrugTypeEnum?
  behavior                       String?
  behaviorNarrative              String?
  chargeType                     ChargeTypeEnum?
  certifiedAt                    DateTime?
  property                       PropertyEnum?
  propertyDetails                String?
  propertyNotReturnedReason      PropertyNotReturnedReasonEnum?
  propertyNotReturnedOtherReason String?
  propertyReturned             Boolean?
  propertyReturnedAt           DateTime?
  propertyReturnedBy           User?                   @relation("PropertyReturnedBy", fields: [propertyReturnedById], references: [id])
  propertyReturnedById         String?                 @db.Uuid
  currentOfficer               User?                   @relation("CurrentOfficer", fields: [currentOfficerId], references: [id])
  currentOfficerId             String?                 @db.Uuid
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                  String                  @db.Uuid
  expiresAt                    DateTime                @default(dbgenerated("(now() + '01:30:00'::interval)"))
  completedAt                  DateTime?
  status                       HoldStatusEnum          @default(ACTIVE)
  extensionCount               Int                     @default(0)
  cancelReason                 DeflectionCancelReasonEnum?
  cancelledAt                  DateTime?
  cancelledBy                  User?                   @relation("CancelledBy", fields: [cancelledById], references: [id])
  cancelledById                String?                 @db.Uuid
  transferredAt                DateTime?
  transferredBy                User?                   @relation("TransferredBy", fields: [transferredById], references: [id])
  transferredById              String?                 @db.Uuid
  transferredByBadgeNumber     String?
  transferredByProp115Certified Boolean?
  transferredByOrganizationId  String?
  transferredByOrganization    Organization?           @relation(fields: [transferredByOrganizationId], references: [id])
  transferredByUnitId          String?
  transferredByUnit            Unit?                   @relation(fields: [transferredByOrganizationId, transferredByUnitId], references: [organizationId, id])
  transferredByTitleId         String?
  transferredByTitle           Title?                  @relation(fields: [transferredByOrganizationId, transferredByTitleId], references: [organizationId, id])
  medicalIntakeStartedAt                 DateTime?
  medicalIntakeStartedBy                 User?                   @relation("MedicalIntakeStartedBy", fields: [medicalIntakeStartedById], references: [id])
  medicalIntakeStartedById               String?                 @db.Uuid
  rejectedAt                   DateTime?
  rejectedBy                   User?                   @relation("RejectedBy", fields: [rejectedById], references: [id])
  rejectedById                 String?                 @db.Uuid
  releasedAt                   DateTime?
  releasedBy                   User?                   @relation("ReleasedBy", fields: [releasedById], references: [id])
  releasedById                 String?                 @db.Uuid
  releaseReason                DeflectionReleaseReasonEnum?
  otherReleaseReason           String?
  otherReleaseDestination      String?
  releaseNarrative             String?
  refusalReason                DeflectionRefusalReasonEnum?
  exitedAt                     DateTime?
  exitedBy                     User?                   @relation("ExitedBy", fields: [exitedById], references: [id])
  exitedById                   String?                 @db.Uuid
  exitDestination              DeflectionExitDestinationEnum?
  exitHousingStatus            DeflectionExitHousingStatusEnum?
  exitConnectedToCare          TernaryEnum?
  exitSFResident               SFResidentEnum?
  arrivedAt                    DateTime?
  handoffReadyAt               DateTime?
  // When the NEW_HOLD ("in transit") SMS fired for this hold — set once, when the
  // hold first becomes ready for transfer (details complete), so it can't re-fire.
  newHoldNotifiedAt            DateTime?
  updatedAt                    DateTime                @updatedAt

  deflectionUpdates   DeflectionUpdate[]
  deflectionDocuments DeflectionDocument[]
  propertyPhotos      PropertyPhoto[]
  handoffs            Handoff[]
}

model DeflectionUpdate {
  id                             String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deflection                     Deflection                     @relation(fields: [deflectionId], references: [id])
  deflectionId                   Int
  status                         HoldStatusEnum?
  expiresAt                      DateTime?
  extensionCount                 Int?
  cancelReason                   DeflectionCancelReasonEnum?
  subjectStatus                  SubjectStatusEnum?
  releaseReason                  DeflectionReleaseReasonEnum?
  otherReleaseReason             String?
  otherReleaseDestination        String?
  propertyReturned               Boolean?
  propertyNotReturnedReason      PropertyNotReturnedReasonEnum?
  propertyNotReturnedOtherReason String?
  refusalReason                DeflectionRefusalReasonEnum?
  exitDestination              DeflectionExitDestinationEnum?
  exitHousingStatus            DeflectionExitHousingStatusEnum?
  exitConnectedToCare          TernaryEnum?
  exitSFResident               SFResidentEnum?
  updatedAt                    DateTime                @default(now())
  updatedBy                    User                    @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid
}


model DeflectionDocument {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deflection                   Deflection              @relation(fields: [deflectionId], references: [id], onDelete: Cascade)
  deflectionId                 Int
  formId                       String
  /// @pii-asset — S3 object contains subject PII; deleted and file cleared on anonymization
  file                         String?
  sourceDataHash               String?
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid

  @@unique([deflectionId, formId])
}

model SatisfactionSurvey {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization           Organization @relation(fields: [organizationId], references: [id])
  organizationId         String
  careConnectRating      String
  improvementSuggestions String?
  resetFacilityFeedback  String?
  createdAt              DateTime     @default(now())

  @@index([createdAt])
  @@index([organizationId])
  @@map("SatisfactionSurvey")
}

model PropertyPhoto {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deflection                   Deflection              @relation(fields: [deflectionId], references: [id], onDelete: Cascade)
  deflectionId                 Int
  /// @pii-asset — S3 object may identify subject; deleted and file cleared on anonymization
  file                         String?
  createdAt                    DateTime                @default(now())
  createdBy                    User                    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById                  String                  @db.Uuid
  updatedAt                    DateTime                @updatedAt
  updatedBy                    User                    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  updatedById                  String                  @db.Uuid
}

model Incident {
  id                      Int                 @unique @default(autoincrement())
  facilityId              String              @db.Uuid
  facility                Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  latitude                Decimal?            @db.Decimal(9, 6)
  longitude               Decimal?            @db.Decimal(9, 6)
  arrestedAt              DateTime?
  encounteredVia          EncounteredViaEnum?
  cadNumber               String?
  caseNumber              String?
  supervisorBadgeNumber   String?
  createdBy               User                @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById             String              @db.Uuid
  createdByOrganization   Organization?       @relation(fields: [createdByOrganizationId], references: [id], onDelete: Restrict)
  createdByOrganizationId String?
  createdByTitle          Title?              @relation(fields: [createdByOrganizationId, createdByTitleId], references: [organizationId, id], onDelete: Restrict)
  createdByTitleId        String?
  createdByUnit           Unit?               @relation(fields: [createdByOrganizationId, createdByUnitId], references: [organizationId, id], onDelete: Restrict)
  createdByUnitId         String?
  createdByBadgeNumber    String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  updatedBy               User                @relation("UpdatedBy", fields: [updatedById], references: [id])
  updatedById             String              @db.Uuid

  deflections Deflection[]

  @@id([id, facilityId])
  @@index([cadNumber])
  @@index([caseNumber])
}

model Feedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message   String
  userEmail String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum FacilityCheckInEventEnum {
  ARRIVAL
  DEPARTURE
}

model FacilityCheckIn {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user                     User                     @relation("FacilityCheckIns", fields: [userId], references: [id])
  userId                   String                   @db.Uuid
  facility                 Facility                 @relation(fields: [facilityId], references: [id])
  facilityId               String                   @db.Uuid
  timestamp                DateTime                 @default(now())
  eventType                FacilityCheckInEventEnum
  arrivedWithDeflectionIds Int[]

  @@index([userId, facilityId, timestamp])
}

model Handoff {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deflection    Deflection @relation(fields: [deflectionId], references: [id])
  deflectionId  Int
  fromOfficer   User       @relation("HandoffFrom", fields: [fromOfficerId], references: [id])
  fromOfficerId String     @db.Uuid
  toOfficer     User       @relation("HandoffTo", fields: [toOfficerId], references: [id])
  toOfficerId   String     @db.Uuid
  timestamp     DateTime   @default(now())

  @@index([deflectionId])
}
